PORT=3000
SESSION_SECRET=replace_with_a_long_random_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Google OAuth 2.0 credentials for a Web application.
# Create these in Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional. Leave blank to create "Student Photos" directly in My Drive root.
# If you want it inside another My Drive folder, paste that folder ID here.
GOOGLE_DRIVE_PARENT_FOLDER_ID=
